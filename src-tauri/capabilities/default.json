{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the local VibePBL desktop workspace",
  "windows": ["main", "print"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute"
  ]
}
